<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/unit/bootstrap.php"
	colors="true"
	failOnWarning="true"
	failOnRisky="true"
	verbose="false"
>
	<testsuites>
		<testsuite name="Core behavioral unit tests">
			<directory>tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
